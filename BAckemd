class EvaluationEngine:
    """Advanced evaluation engine with full tracing"""
    
    def __init__(self):
        self._function_handlers = self._build_function_handlers()
        self._evaluation_cache = {}
        self._operation_tracker = {}
        
    def _build_function_handlers(self) -> Dict:
        """Build function evaluation handlers"""
        return {
            # Lookup Functions
            'VLOOKUP': self._evaluate_vlookup,
            'XLOOKUP': self._evaluate_xlookup,
            'INDEX': self._evaluate_index,
            'MATCH': self._evaluate_match,
            
            # Conditional Functions
            'IF': self._evaluate_if,
            'IFS': self._evaluate_ifs,
            'IFERROR': self._evaluate_iferror,
            'AND': self._evaluate_and,
            'OR': self._evaluate_or,
            'NOT': self._evaluate_not,
            
            # Aggregation Functions
            'SUM': self._evaluate_sum,
            'SUMIF': self._evaluate_sumif,
            'SUMIFS': self._evaluate_sumifs,
            'COUNT': self._evaluate_count,
            'COUNTA': self._evaluate_counta,
            'COUNTIF': self._evaluate_countif,
            'COUNTIFS': self._evaluate_countifs,
            'AVERAGE': self._evaluate_average,
            'AVERAGEIF': self._evaluate_averageif,
            'AVERAGEIFS': self._evaluate_averageifs,
            
            # Mathematical Functions
            'ROUND': self._evaluate_round,
            'ROUNDUP': self._evaluate_roundup,
            'ROUNDDOWN': self._evaluate_rounddown,
            'ABS': self._evaluate_abs,
            'MOD': self._evaluate_mod,
            'POWER': self._evaluate_power,
            'PRODUCT': self._evaluate_product,
            
            # Text Functions
            'LEFT': self._evaluate_left,
            'RIGHT': self._evaluate_right,
            'MID': self._evaluate_mid,
            'LEN': self._evaluate_len,
            'TRIM': self._evaluate_trim,
            'CONCAT': self._evaluate_concat,
        }
    
    def evaluate(self, 
                 node: FormulaNode, 
                 context: AnalysisContext,
                 cell_ref: CellReference,
                 workbook: Workbook) -> Tuple[Any, Dict]:
        """
        Evaluate AST node with full tracing
        
        Returns:
        - Result value
        - Trace information
        """
        trace = {
            'steps': [],
            'executed': True,
            'branch': None,
            'details': {}
        }
        
        # Check cache
        cache_key = self._get_cache_key(node, context, cell_ref)
        if cache_key in self._evaluation_cache:
            cached_result, cached_trace = self._evaluation_cache[cache_key]
            return cached_result, cached_trace
        
        # Evaluate based on node type
        try:
            if node.node_type == 'NUMBER':
                result = node.value
                trace['steps'].append(f"Value: {result}")
            
            elif node.node_type == 'STRING':
                result = node.value
                trace['steps'].append(f"String: {result}")
            
            elif node.node_type == 'REFERENCE':
                # Resolve reference
                ref = self._parse_reference(node.value, cell_ref)
                cell_data = workbook.get_cell(ref)
                if cell_data:
                    if cell_data.is_formula:
                        # Parse and evaluate formula
                        parser = ExcelFormulaParser()
                        formula_node = parser.parse(cell_data.formula, context)
                        result, sub_trace = self.evaluate(formula_node, context, ref, workbook)
                        trace['steps'].extend(sub_trace.get('steps', []))
                        trace['details']['reference'] = ref.address
                        trace['details']['formula'] = cell_data.formula
                    else:
                        result = cell_data.value
                        trace['steps'].append(f"Reference {ref.address}: {result}")
                        trace['details']['reference'] = ref.address
                else:
                    result = None
                    context.add_warning(f"Cell not found: {ref.address}")
            
            elif node.node_type == 'FUNCTION':
                # Evaluate function
                function_name = node.value
                result, func_trace = self._evaluate_function(node, context, cell_ref, workbook)
                trace['steps'].extend(func_trace.get('steps', []))
                trace['details'].update(func_trace.get('details', {}))
                trace['branch'] = func_trace.get('branch')
            
            elif node.node_type == 'OPERATOR':
                # Evaluate binary operator
                left, left_trace = self.evaluate(node.children[0], context, cell_ref, workbook)
                right, right_trace = self.evaluate(node.children[1], context, cell_ref, workbook)
                trace['steps'].extend(left_trace.get('steps', []))
                trace['steps'].extend(right_trace.get('steps', []))
                result = self._apply_operator(node.value, left, right)
                trace['steps'].append(f"{left} {node.value} {right} = {result}")
            
            else:
                # Unknown node type
                result = None
                context.add_error(f"Unknown node type: {node.node_type}")
            
            # Cache result
            self._evaluation_cache[cache_key] = (result, trace)
            return result, trace
            
        except Exception as e:
            context.add_error(f"Evaluation error: {str(e)}", {'node': node.to_dict()})
            return None, {'error': str(e), 'executed': False}
    
    def _evaluate_function(self, 
                          node: FormulaNode,
                          context: AnalysisContext,
                          cell_ref: CellReference,
                          workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate function with specific handler"""
        function_name = node.value
        trace = {'steps': [], 'details': {}}
        
        if function_name in self._function_handlers:
            # Evaluate arguments
            args = []
            arg_traces = []
            for child in node.children:
                arg, arg_trace = self.evaluate(child, context, cell_ref, workbook)
                args.append(arg)
                arg_traces.append(arg_trace)
            
            # Call handler
            try:
                result, handler_trace = self._function_handlers[function_name](
                    args, node, context, cell_ref, workbook
                )
                trace['steps'].extend(handler_trace.get('steps', []))
                trace['details'].update(handler_trace.get('details', {}))
                trace['branch'] = handler_trace.get('branch')
                trace['details']['function'] = function_name
                trace['details']['args'] = args
                return result, trace
            except Exception as e:
                context.add_error(f"Error in {function_name}: {str(e)}")
                return None, {'error': str(e), 'executed': False}
        else:
            context.add_warning(f"Unsupported function: {function_name}")
            return None, {'error': f'UNSUPPORTED: {function_name}', 'executed': False}
    
    def _apply_operator(self, operator: str, left: Any, right: Any) -> Any:
        """Apply binary operator"""
        if operator == '+':
            return left + right
        elif operator == '-':
            return left - right
        elif operator == '*':
            return left * right
        elif operator == '/':
            return left / right if right != 0 else '#DIV/0!'
        elif operator == '^':
            return left ** right
        elif operator == '=':
            return left == right
        elif operator == '<':
            return left < right
        elif operator == '>':
            return left > right
        elif operator == '<=':
            return left <= right
        elif operator == '>=':
            return left >= right
        elif operator == '<>':
            return left != right
        elif operator == '&':
            return str(left) + str(right)
        else:
            return None
    
