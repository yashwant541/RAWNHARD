class VisualizationEngine:
    """Advanced visualization with interactive graphs"""
    
    def __init__(self):
        self._figure_cache = {}
    
    def create_dependency_graph(self, 
                               graph: nx.DiGraph,
                               target_cell: Optional[CellReference] = None) -> go.Figure:
        """Create interactive dependency graph"""
        
        # Create layout
        pos = nx.spring_layout(graph, k=1, iterations=50)
        
        # Prepare edge traces
        edge_x = []
        edge_y = []
        for edge in graph.edges():
            x0, y0 = pos[edge[0]]
            x1, y1 = pos[edge[1]]
            edge_x.extend([x0, x1, None])
            edge_y.extend([y0, y1, None])
        
        edge_trace = go.Scatter(
            x=edge_x, y=edge_y,
            line=dict(width=1, color='#888'),
            hoverinfo='none',
            mode='lines'
        )
        
        # Prepare node traces
        node_x = []
        node_y = []
        node_text = []
        node_colors = []
        
        for node in graph.nodes():
            x, y = pos[node]
            node_x.append(x)
            node_y.append(y)
            
            # Get node label
            if isinstance(node, CellReference):
                label = node.address
            else:
                label = str(node)
            node_text.append(label)
            
            # Color based on node type
            if isinstance(node, CellReference):
                if target_cell and node == target_cell:
                    node_colors.append('red')
                elif node in graph.predecessors(target_cell) if target_cell else []:
                    node_colors.append('blue')
                else:
                    node_colors.append('lightblue')
            else:
                node_colors.append('gray')
        
        node_trace = go.Scatter(
            x=node_x, y=node_y,
            mode='markers+text',
            text=node_text,
            textposition='top center',
            hoverinfo='text',
            marker=dict(
                size=20,
                color=node_colors,
                line=dict(width=2, color='darkblue')
            )
        )
        
        # Create figure
        fig = go.Figure(
            data=[edge_trace, node_trace],
            layout=go.Layout(
                title='Dependency Graph',
                showlegend=False,
                hovermode='closest',
                margin=dict(b=20, l=5, r=5, t=40),
                annotations=[dict(
                    text="Interactive Dependency Graph",
                    showarrow=False,
                    xref="paper", yref="paper",
                    x=0.005, y=-0.002
                )],
                xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
                yaxis=dict(showgrid=False, zeroline=False, showticklabels=False)
            )
        )
        
        return fig
    
    def create_formula_tree(self, ast: FormulaNode) -> go.Figure:
        """Create interactive formula tree visualization"""
        
        # Build tree layout
        labels = []
        parents = []
        
        def traverse(node: FormulaNode, parent_id: str = None):
            node_id = node._id
            labels.append(f"{node.node_type}: {node.value if node.value else ''}")
            parents.append(parent_id or '')
            
            for child in node.children:
                traverse(child, node_id)
        
        traverse(ast)
        
        # Create treemap
        fig = go.Figure(go.Treemap(
            labels=labels,
            parents=parents,
            textinfo='label',
            marker=dict(
                colors='lightblue',
                line=dict(width=1, color='darkblue')
            )
        ))
        
        fig.update_layout(
            title='Formula Tree (AST)',
            margin=dict(t=40, l=0, r=0, b=0)
        )
        
        return fig
    
    def create_calculation_trace(self, steps: List[Dict]) -> go.Figure:
        """Create calculation trace visualization"""
        
        # Extract step data
        step_numbers = [step.get('step', i+1) for i, step in enumerate(steps)]
        operations = [step.get('operation', '') for step in steps]
        results = [step.get('result', '') for step in steps]
        
        # Create horizontal bar chart
        fig = go.Figure(data=[
            go.Bar(
                x=[1] * len(steps),
                y=step_numbers,
                orientation='v',
                text=[f"{op}: {result}" for op, result in zip(operations, results)],
                textposition='outside',
                marker=dict(
                    color='lightblue',
                    line=dict(color='darkblue', width=1)
                ),
                hoverinfo='text',
                hovertext=[f"Step {i+1}: {op} → {result}" 
                          for i, (op, result) in enumerate(zip(operations, results))]
            )
        ])
        
        fig.update_layout(
            title='Calculation Trace',
            xaxis=dict(
                title='Steps',
                showticklabels=False
            ),
            yaxis=dict(
                title='Step Number',
                autorange='reversed'
            ),
            margin=dict(t=40, l=0, r=0, b=0),
            height=max(300, len(steps) * 30)
        )
        
        return fig
    
    def create_heatmap(self, workbook: Workbook, sheet: str) -> go.Figure:
        """Create heatmap of cell values"""
        
        # Get cells from sheet
        cells = workbook.get_cells_by_sheet(sheet)
        
        if not cells:
            return go.Figure()
        
        # Build matrix
        rows = max(c.reference.row for c in cells)
        cols = max(c.reference.col for c in cells)
        
        matrix = [[None for _ in range(cols)] for _ in range(rows)]
        
        for cell in cells:
            if cell.value is not None:
                row = cell.reference.row - 1
                col = cell.reference.col - 1
                
                # Try to convert to number for heatmap
                try:
                    if isinstance(cell.value, (int, float)):
                        matrix[row][col] = cell.value
                    elif isinstance(cell.value, str):
                        # Try to parse number from string
                        try:
                            matrix[row][col] = float(cell.value.replace(',', ''))
                        except:
                            matrix[row][col] = None
                    else:
                        matrix[row][col] = None
                except:
                    matrix[row][col] = None
        
        # Create heatmap
        fig = go.Figure(data=go.Heatmap(
            z=matrix,
            colorscale='Blues',
            showscale=True,
            hoverongaps=False
        ))
        
        fig.update_layout(
            title=f'Value Heatmap - {sheet}',
            xaxis=dict(title='Column'),
            yaxis=dict(title='Row', autorange='reversed'),
            margin=dict(t=40, l=0, r=0, b=0)
        )
        
        return fig

