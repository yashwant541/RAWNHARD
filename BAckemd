            ], className="my-4"),
            
            dbc.Row([
                dbc.Col([
                    html.Div(id='analysis-results')
                ], width=12)
            ]),
            
            # Loading spinner
            dcc.Loading(
                id='loading-spinner',
                type='default',
                children=html.Div(id='loading-output')
            ),
            
            # Store for analysis results
            dcc.Store(id='analysis-store')
            
        ], fluid=True)
    
    def setup_callbacks(self):
        """Setup application callbacks"""
        
        @self.app.callback(
            [Output('sheet-selector', 'options'),
             Output('sheet-selector', 'disabled')],
            [Input('upload-workbook', 'contents')],
            [State('upload-workbook', 'filename')]
        )
        def update_sheets(contents, filename):
            """Update sheet selector when workbook is uploaded"""
            if contents is not None:
                # Process uploaded file
                try:
                    # Save file temporarily
                    temp_path = self._save_uploaded_file(contents, filename)
                    loader = WorkbookLoader(temp_path)
                    workbook = loader.load()
                    
                    # Get sheet names
                    sheets = list(workbook.sheets.keys())
                    options = [{'label': s, 'value': s} for s in sheets]
                    return options, False
                    
                except Exception as e:
                    logger.error(f"Error processing upload: {e}")
                    return [], True
            
            return [], True
        
        @self.app.callback(
            Output('analysis-results', 'children'),
            [Input('analyze-button', 'n_clicks')],
            [State('upload-workbook', 'contents'),
             State('upload-workbook', 'filename'),
             State('sheet-selector', 'value'),
             State('cell-input', 'value')]
        )
        def perform_analysis(n_clicks, contents, filename, sheet, cell):
            """Perform formula analysis"""
            if n_clicks is None:
                return html.Div("Upload a workbook and enter a cell to analyze")
            
            if not contents or not sheet or not cell:
                return dbc.Alert(
                    "Please upload a workbook and specify sheet and cell",
                    color="warning"
                )
            
            try:
                # Save uploaded file
                temp_path = self._save_uploaded_file(contents, filename)
                
                # Analyze formula
                result = self.analyzer.analyze_formula(
                    temp_path, sheet, cell
                )
                
                # Generate report
                report = self.analyzer.report_generator.generate_report(
                    result, 'html'
                )
                
                # Return HTML report
                return html.Iframe(
                    srcDoc=report,
                    style={'width': '100%', 'height': '800px', 'border': 'none'}
                )
                
            except Exception as e:
                logger.error(f"Analysis error: {e}", exc_info=True)
                return dbc.Alert(
                    f"Error analyzing formula: {str(e)}",
                    color="danger"
                )
    
    def _save_uploaded_file(self, contents, filename):
        """Save uploaded file to temporary location"""
        import base64
        import tempfile
        
        # Decode contents
        content_type, content_string = contents.split(',')
        decoded = base64.b64decode(content_string)
        
        # Save to temp file
        temp_dir = tempfile.mkdtemp()
        temp_path = os.path.join(temp_dir, filename)
        
        with open(temp_path, 'wb') as f:
            f.write(decoded)
        
        return temp_path
    
    def run(self, debug: bool = True, port: int = 8050):
        """Run the web application"""
        self.app.run_server(debug=debug, port=port)

# -----------------------------------------------------------------------------
# COMMAND-LINE INTERFACE
# -----------------------------------------------------------------------------

def main():
    """Main entry point"""
    import argparse
    
    parser = argparse.ArgumentParser(
        description='Excel Formula Analyzer - The Sherlock Holmes of Excel'
    )
    parser.add_argument('workbook', help='Path to Excel workbook')
    parser.add_argument('--sheet', '-s', required=True, help='Sheet name')
    parser.add_argument('--cell', '-c', required=True, help='Cell address (e.g., F2)')
    parser.add_argument('--output', '-o', help='Output file (supports .html, .json, .txt)')
    parser.add_argument('--web', '-w', action='store_true', help='Run web interface')
    parser.add_argument('--port', type=int, default=8050, help='Web interface port')
    
    args = parser.parse_args()
    
    if args.web:
        # Run web interface
        analyzer = ExcelFormulaAnalyzer()
        app = ExcelAnalyzerWebApp(analyzer)
        app.run(port=args.port)
    else:
        # Run command-line analysis
        analyzer = ExcelFormulaAnalyzer()
        result = analyzer.analyze_formula(
            args.workbook, args.sheet, args.cell
        )
        
        if args.output:
            # Determine format from extension
            ext = os.path.splitext(args.output)[1].lower()
            if ext == '.html':
                report = analyzer.report_generator.generate_report(result, 'html')
            elif ext == '.json':
                report = analyzer.report_generator.generate_report(result, 'json')
            else:
                report = analyzer.report_generator.generate_report(result, 'txt')
            
            with open(args.output, 'w') as f:
                f.write(report)
            print(f"Report saved to {args.output}")
        else:
            # Print to console
            report = analyzer.report_generator.generate_report(result, 'txt')
            print(report)

if __name__ == "__main__":
    main()
