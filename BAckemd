        lines.append("-" * 80)
        for step in data.get('calculation_steps', []):
            lines.append(f"Step {step['step']}: {step['operation']} → {step['result']}")
        lines.append("")
        lines.append("-" * 80)
        lines.append("SOURCE LINEAGE")
        lines.append("-" * 80)
        for lineage in data.get('source_lineage', []):
            lines.append(lineage)
        lines.append("")
        lines.append("-" * 80)
        lines.append("ISSUES DETECTED")
        lines.append("-" * 80)
        for issue_type, issues in data.get('issues', {}).items():
            lines.append(f"\n{issue_type.upper()}:")
            for issue in issues:
