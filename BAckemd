class WorkbookLoader:
    """Enterprise-grade workbook loader with streaming and caching"""
    
    def __init__(self, filepath: str, options: Dict = None):
        self.filepath = filepath
        self.options = options or {}
        self._workbook = None
        self._workbook_hash = None
        self._cell_cache = {}
        self._sheet_cache = {}
        self._named_range_cache = {}
        self._table_cache = {}
        self._metadata = {}
        
    def load(self) -> 'Workbook':
        """Load workbook with progressive loading strategy"""
        logger.info(f"Loading workbook: {self.filepath}")
        
        # Check if file exists
        if not os.path.exists(self.filepath):
            raise FileNotFoundError(f"Workbook not found: {self.filepath}")
        
        # Create workbook object
        workbook = Workbook(self.filepath)
        
        # Load using openpyxl
        try:
            wb = openpyxl.load_workbook(
                self.filepath,
                data_only=True,
                read_only=self.options.get('read_only', False),
                keep_links=self.options.get('keep_links', True)
            )
            
            # Load metadata
            workbook.metadata = {
                'title': wb.properties.title,
                'creator': wb.properties.creator,
                'created': wb.properties.created,
                'modified': wb.properties.modified,
                'last_modified_by': wb.properties.lastModifiedBy
            }
            
            # Load sheets
            for sheet_name in wb.sheetnames:
                sheet = wb[sheet_name]
                workbook.add_sheet(sheet_name, sheet)
                
                # Load cells
                for row in sheet.iter_rows():
                    for cell in row:
                        if cell.value is not None:
                            ref = CellReference(
                                sheet=sheet_name,
                                row=cell.row,
                                col=cell.column
                            )
                            
                            cell_data = CellData(
                                reference=ref,
                                value=cell.value,
                                formula=cell.value if isinstance(cell.value, str) and cell.value.startswith('=') else None,
                                cell_type=CellType.FORMULA if isinstance(cell.value, str) and cell.value.startswith('=') 
                                         else CellType.VALUE if cell.value is not None 
                                         else CellType.EMPTY,
                                data_type=type(cell.value).__name__,
                                formatting={
                                    'font': cell.font.name if cell.font else None,
                                    'size': cell.font.size if cell.font else None,
                                    'bold': cell.font.bold if cell.font else None,
                                    'italic': cell.font.italic if cell.font else None,
                                    'color': cell.font.color.rgb if cell.font and cell.font.color else None,
                                    'number_format': cell.number_format,
                                    'alignment': cell.alignment.horizontal if cell.alignment else None
                                },
                                is_hidden=cell.hidden if hasattr(cell, 'hidden') else False,
                                comment=cell.comment.text if cell.comment else None,
                                cached_value=cell.value
                            )
                            
                            workbook.add_cell(cell_data)
            
            # Load named ranges
            for named_range in wb.defined_names:
                try:
                    range_data = {
                        'name': named_range.name,
                        'scope': named_range.scope.title if named_range.scope else 'Workbook',
                        'value': named_range.value,
                        'type': 'RANGE'
                    }
                    workbook.add_named_range(range_data)
                except:
                    pass
            
            # Load tables
            for sheet_name, sheet in wb.items():
                for table in sheet.tables.values():
                    table_data = {
                        'name': table.name,
                        'sheet': sheet_name,
                        'range': table.ref,
                        'columns': [col.name for col in table.tableColumns]
                    }
                    workbook.add_table(table_data)
            
            workbook.hash = self._calculate_hash(workbook)
            self._workbook = workbook
            
            logger.info(f"Loaded workbook with {len(workbook.sheets)} sheets, "
                       f"{len(workbook.cells)} cells, "
                       f"{len(workbook.named_ranges)} named ranges, "
                       f"{len(workbook.tables)} tables")
            
            return workbook
            
        except Exception as e:
            logger.error(f"Error loading workbook: {e}")
            raise
    
    def _calculate_hash(self, workbook: 'Workbook') -> str:
        """Calculate workbook hash for change detection"""
        content = f"{workbook.filepath}:{len(workbook.sheets)}:{len(workbook.cells)}"
        return hashlib.md5(content.encode()).hexdigest()[:16]

class Workbook:
    """Complete workbook representation"""
    
    def __init__(self, filepath: str):
        self.filepath = filepath
        self.hash = None
        self.metadata = {}
        self.sheets = {}
        self.cells = {}
        self.named_ranges = {}
        self.tables = {}
        self._cell_index = {}
        
    def add_sheet(self, name: str, sheet_data: Any):
        self.sheets[name] = sheet_data
    
    def add_cell(self, cell_data: CellData):
        self.cells[cell_data.reference] = cell_data
        key = f"{cell_data.reference.sheet}:{cell_data.reference.row}:{cell_data.reference.col}"
        self._cell_index[key] = cell_data
    
    def get_cell(self, ref: CellReference) -> Optional[CellData]:
        key = f"{ref.sheet}:{ref.row}:{ref.col}"
        return self._cell_index.get(key)
    
    def add_named_range(self, range_data: Dict):
        self.named_ranges[range_data['name']] = range_data
    
    def add_table(self, table_data: Dict):
        self.tables[table_data['name']] = table_data
    
    def get_cells_by_sheet(self, sheet: str) -> List[CellData]:
        return [cell for cell in self.cells.values() if cell.reference.sheet == sheet]

