"""
===============================================================
EXCEL FORMULA BACKTRACKING FLOWCHART
===============================================================

Purpose
-------
Creates an interactive HTML flowchart explaining exactly how
an Excel formula arrived at its result.

The example demonstrates:

    IFERROR
      └── VLOOKUP
      └── INDEX / MATCH
      └── SUMIFS
      └── Arithmetic operations

Output
------
formula_backtracking_flowchart.html

Dependencies
------------
None.

This script uses only Python's standard library.

You can later replace the example values with values read from
Excel using openpyxl.
===============================================================
"""

from pathlib import Path
from html import escape
import json


# ==============================================================
# CONFIGURATION
# ==============================================================

OUTPUT_FILE = "formula_backtracking_flowchart.html"

FORMULA = """
=IFERROR(
 VLOOKUP(A2,Customer_Master!A:D,4,FALSE) *
 INDEX(Rates!B:D,MATCH(B2,Rates!B:B,0),3)
 + SUMIFS(
     Commission!D:D,
     Commission!A:A,A2,
     Commission!B:B,"Loan"
   ),
0)
""".strip()


# ==============================================================
# COLOR DEFINITIONS
# ==============================================================

COLORS = {

    # Original formula / major formula blocks
    "formula": {
        "background": "#1565C0",
        "border": "#0D47A1",
        "font": "#FFFFFF"
    },

    # Lookup functions
    "lookup": {
        "background": "#7E57C2",
        "border": "#512DA8",
        "font": "#FFFFFF"
    },

    # Successfully resolved source value
    "source": {
        "background": "#43A047",
        "border": "#1B5E20",
        "font": "#FFFFFF"
    },

    # Intermediate calculations
    "calculation": {
        "background": "#FDD835",
        "border": "#F9A825",
        "font": "#212121"
    },

    # Conditions / decisions
    "condition": {
        "background": "#FB8C00",
        "border": "#E65100",
        "font": "#FFFFFF"
    },

    # Final answer
    "final": {
        "background": "#00796B",
        "border": "#004D40",
        "font": "#FFFFFF"
    },

    # Not executed
    "inactive": {
        "background": "#E0E0E0",
        "border": "#9E9E9E",
        "font": "#616161"
    },

    # Error
    "error": {
        "background": "#E53935",
        "border": "#B71C1C",
        "font": "#FFFFFF"
    }
}


# ==============================================================
# HELPER
# ==============================================================

nodes = []
edges = []


def add_node(
    node_id,
    title,
    subtitle="",
    node_type="formula",
    detail="",
    level=None,
    shape="box"
):
    """
    Add a node to the formula flowchart.
    """

    color = COLORS[node_type]

    label = title

    if subtitle:
        label += "\n" + subtitle

    node = {
        "id": node_id,
        "label": label,
        "shape": shape,

        "color": {
            "background": color["background"],
            "border": color["border"],
            "highlight": {
                "background": color["background"],
                "border": "#000000"
            }
        },

        "font": {
            "color": color["font"],
            "face": "Arial",
            "size": 15,
            "multi": True
        },

        "borderWidth": 2,

        "margin": {
            "top": 12,
            "bottom": 12,
            "left": 15,
            "right": 15
        },

        "title": detail
    }

    if level is not None:
        node["level"] = level

    nodes.append(node)


def add_edge(source, target, label="", dashed=False):
    """
    Add connection between calculation steps.
    """

    edge = {
        "from": source,
        "to": target,
        "arrows": "to",
        "label": label,
        "font": {
            "size": 12,
            "align": "middle"
        },
        "color": {
            "color": "#607D8B",
            "highlight": "#1565C0"
        },
        "width": 2
    }

    if dashed:
        edge["dashes"] = True

    edges.append(edge)


# ==============================================================
# EXAMPLE SOURCE DATA
# ==============================================================

# --------------------------------------------------------------
# Summary Sheet
# --------------------------------------------------------------

summary_A2 = "CUST1001"
summary_B2 = "India"


# --------------------------------------------------------------
# Customer Master
# --------------------------------------------------------------

customer_master = {
    "CUST1001": {
        "row": 15,
        "revenue": 50000
    }
}


# --------------------------------------------------------------
# Rates Table
# --------------------------------------------------------------

rates = {
    "India": {
        "row": 8,
        "rate": 1.10
    }
}


# --------------------------------------------------------------
# Commission Table
# --------------------------------------------------------------

commission_rows = [

    {
        "row": 12,
        "id": "CUST1001",
        "type": "Loan",
        "amount": 1500
    },

    {
        "row": 27,
        "id": "CUST1001",
        "type": "Loan",
        "amount": 1000
    },

    {
        "row": 40,
        "id": "CUST1002",
        "type": "Loan",
        "amount": 5000
    }
]


# ==============================================================
# ACTUAL BACKTRACKING CALCULATION
# ==============================================================


# --------------------------------------------------------------
# STEP 1
# Original formula
# --------------------------------------------------------------

add_node(
    "formula",
    "ORIGINAL FORMULA",
    "Summary!F2",
    "formula",
    detail=FORMULA,
    level=0
)


# --------------------------------------------------------------
# STEP 2
# IFERROR
# --------------------------------------------------------------

add_node(
    "iferror",
    "IFERROR",
    "Evaluate main expression",
    "condition",
    detail=(
        "Excel first evaluates the main expression.\n\n"
        "If the expression generates an error,\n"
        "the formula returns 0."
    ),
    level=1
)

add_edge(
    "formula",
    "iferror",
    "Start evaluation"
)


# --------------------------------------------------------------
# STEP 3
# Main expression
# --------------------------------------------------------------

add_node(
    "main_expression",
    "MAIN EXPRESSION",
    "Lookup × Rate + Commission",
    "formula",
    level=2
)

add_edge(
    "iferror",
    "main_expression",
    "Try"
)


# --------------------------------------------------------------
# ERROR FALLBACK
# --------------------------------------------------------------

add_node(
    "fallback",
    "ERROR FALLBACK",
    "Return 0",
    "inactive",
    detail="This branch is only executed if the main formula fails.",
    level=2
)

add_edge(
    "iferror",
    "fallback",
    "If Error",
    dashed=True
)


# ==============================================================
# VLOOKUP TRACE
# ==============================================================

add_node(
    "vlookup",
    "VLOOKUP",
    "Find customer revenue",
    "lookup",
    detail=(
        "Formula:\n"
        "VLOOKUP(A2,Customer_Master!A:D,4,FALSE)"
    ),
    level=3
)

add_edge(
    "main_expression",
    "vlookup"
)


# --------------------------------------------------------------
# Lookup value A2
# --------------------------------------------------------------

add_node(
    "A2",
    "LOOKUP VALUE",
    f"A2 = {summary_A2}",
    "source",
    detail="Source: Summary!A2",
    level=4
)

add_edge(
    "vlookup",
    "A2",
    "Lookup value"
)


# --------------------------------------------------------------
# Find matching customer
# --------------------------------------------------------------

customer = customer_master.get(summary_A2)

if customer:

    customer_row = customer["row"]
    revenue = customer["revenue"]

    add_node(
        "customer_match",
        "MATCH FOUND",
        f"Customer_Master!A{customer_row}",
        "source",
        detail=(
            f"Lookup key: {summary_A2}\n"
            f"Matched row: {customer_row}"
        ),
        level=5
    )

    add_edge(
        "A2",
        "customer_match",
        "Exact match"
    )


    add_node(
        "revenue",
        "VLOOKUP RESULT",
        f"₹{revenue:,.0f}",
        "source",
        detail=(
            f"Returned Cell:\n"
            f"Customer_Master!D{customer_row}\n\n"
            f"Value:\n"
            f"{revenue}"
        ),
        level=6
    )

    add_edge(
        "customer_match",
        "revenue",
        "Return column 4"
    )

else:

    revenue = 0

    add_node(
        "customer_error",
        "CUSTOMER NOT FOUND",
        "#N/A",
        "error",
        level=5
    )


# ==============================================================
# INDEX + MATCH TRACE
# ==============================================================

add_node(
    "index_match",
    "INDEX / MATCH",
    "Find country rate",
    "lookup",
    detail=(
        "INDEX(\n"
        " Rates!B:D,\n"
        " MATCH(B2,Rates!B:B,0),\n"
        " 3\n"
        ")"
    ),
    level=3
)

add_edge(
    "main_expression",
    "index_match"
)


# --------------------------------------------------------------
# B2
# --------------------------------------------------------------

add_node(
    "B2",
    "MATCH LOOKUP VALUE",
    f"B2 = {summary_B2}",
    "source",
    detail="Source: Summary!B2",
    level=4
)

add_edge(
    "index_match",
    "B2"
)


# --------------------------------------------------------------
# MATCH operation
# --------------------------------------------------------------

rate_record = rates.get(summary_B2)

if rate_record:

    rate_row = rate_record["row"]
    rate = rate_record["rate"]

    add_node(
        "match_result",
        "MATCH RESULT",
        f"India found at row {rate_row}",
        "lookup",
        detail=(
            f"MATCH({summary_B2}, Rates!B:B, 0)\n\n"
            f"Returned position: {rate_row}"
        ),
        level=5
    )

    add_edge(
        "B2",
        "match_result",
        "Search Rates"
    )


    add_node(
        "index_result",
        "INDEX RESULT",
        f"{rate:.2f}",
        "source",
        detail=(
            f"Returned cell:\n"
            f"Rates!D{rate_row}\n\n"
            f"Rate = {rate}"
        ),
        level=6
    )

    add_edge(
        "match_result",
        "index_result",
        "Return column 3"
    )

else:

    rate = 0


# ==============================================================
# MULTIPLICATION
# ==============================================================

adjusted_revenue = revenue * rate


add_node(
    "multiply",
    "MULTIPLICATION",
    f"{revenue:,.0f} × {rate:.2f}",
    "calculation",
    detail=(
        f"Revenue = {revenue:,.0f}\n"
        f"Rate = {rate:.2f}\n\n"
        f"Result = {adjusted_revenue:,.0f}"
    ),
    level=7
)

add_edge(
    "revenue",
    "multiply"
)

add_edge(
    "index_result",
    "multiply"
)


add_node(
    "adjusted_revenue",
    "INTERMEDIATE RESULT",
    f"₹{adjusted_revenue:,.0f}",
    "calculation",
    level=8
)

add_edge(
    "multiply",
    "adjusted_revenue",
    "="
)


# ==============================================================
# SUMIFS
# ==============================================================

add_node(
    "sumifs",
    "SUMIFS",
    "Calculate Loan Commission",
    "lookup",
    detail=(
        "Criteria:\n"
        f"ID = {summary_A2}\n"
        "Type = Loan"
    ),
    level=3
)

add_edge(
    "main_expression",
    "sumifs"
)


# --------------------------------------------------------------
# Criteria
# --------------------------------------------------------------

add_node(
    "criteria1",
    "CRITERIA 1",
    f"ID = {summary_A2}",
    "condition",
    level=4
)

add_edge(
    "sumifs",
    "criteria1"
)


add_node(
    "criteria2",
    "CRITERIA 2",
    "Type = Loan",
    "condition",
    level=4
)

add_edge(
    "sumifs",
    "criteria2"
)


# --------------------------------------------------------------
# Find matching records
# --------------------------------------------------------------

matching_commissions = [

    row
    for row in commission_rows

    if row["id"] == summary_A2
    and row["type"] == "Loan"

]


commission_total = 0


for i, row in enumerate(matching_commissions, start=1):

    node_id = f"commission_{i}"

    commission_total += row["amount"]

    add_node(
        node_id,
        f"MATCHING ROW {row['row']}",
        f"₹{row['amount']:,.0f}",
        "source",
        detail=(
            f"Commission!Row {row['row']}\n"
            f"ID = {row['id']}\n"
            f"Type = {row['type']}\n"
            f"Amount = {row['amount']}"
        ),
        level=5
    )

    add_edge(
        "criteria1",
        node_id
    )

    add_edge(
        "criteria2",
        node_id
    )


# --------------------------------------------------------------
# SUMIFS total
# --------------------------------------------------------------

add_node(
    "commission_total",
    "SUMIFS RESULT",
    f"₹{commission_total:,.0f}",
    "calculation",
    detail=(
        f"Matching records: {len(matching_commissions)}\n"
        f"Total commission = {commission_total}"
    ),
    level=6
)


for i in range(1, len(matching_commissions) + 1):

    add_edge(
        f"commission_{i}",
        "commission_total",
        "Add"
    )


# ==============================================================
# FINAL ADDITION
# ==============================================================

final_result = adjusted_revenue + commission_total


add_node(
    "addition",
    "FINAL ADDITION",
    f"₹{adjusted_revenue:,.0f} + ₹{commission_total:,.0f}",
    "calculation",
    detail=(
        f"{adjusted_revenue:,.0f}\n"
        f"+ {commission_total:,.0f}\n"
        f"= {final_result:,.0f}"
    ),
    level=9
)


add_edge(
    "adjusted_revenue",
    "addition"
)

add_edge(
    "commission_total",
    "addition"
)


# ==============================================================
# IFERROR CHECK
# ==============================================================

add_node(
    "error_check",
    "IFERROR CHECK",
    "Error detected? NO",
    "condition",
    detail=(
        "Main calculation completed successfully.\n\n"
        "Therefore IFERROR fallback is NOT executed."
    ),
    level=10
)

add_edge(
    "addition",
    "error_check"
)


# ==============================================================
# FINAL RESULT
# ==============================================================

add_node(
    "final",
    "FINAL RESULT",
    f"₹{final_result:,.0f}",
    "final",
    detail=(
        f"Summary!F2\n\n"
        f"Final calculated value = {final_result:,.0f}"
    ),
    level=11
)

add_edge(
    "error_check",
    "final",
    "Return result"
)


# ==============================================================
# BUILD HTML
# ==============================================================

nodes_json = json.dumps(nodes, indent=2)

edges_json = json.dumps(edges, indent=2)


html = f"""
<!DOCTYPE html>

<html>

<head>

<meta charset="utf-8">

<title>Excel Formula Backtracking</title>


<script
src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js">
</script>


<style>

body {{
    font-family: Arial, sans-serif;
    margin: 0;
    background: #F4F6F8;
}}


