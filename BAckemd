# -----------------------------------------------------------------------------

class DependencyEngine:
    """Advanced dependency tracking with graph analysis"""
    
    def __init__(self):
        self._dependency_cache = {}
        self._graph = nx.DiGraph()
    
    def trace_dependencies(self, 
                          cell_ref: CellReference,
                          workbook: Workbook,
                          context: AnalysisContext,
                          visited: Set[CellReference] = None) -> Tuple[Set[CellReference], nx.DiGraph]:
        """Trace all dependencies recursively"""
        if visited is None:
            visited = set()
        
        # Prevent infinite recursion
        if cell_ref in visited:
            return set(), self._graph
        visited.add(cell_ref)
        
        dependencies = set()
        
        # Get cell data
        cell_data = workbook.get_cell(cell_ref)
        if not cell_data or not cell_data.is_formula:
            return dependencies, self._graph
        
        # Parse formula
        parser = ExcelFormulaParser()
        ast = parser.parse(cell_data.formula, context)
        
        # Extract references from AST
        refs = self._extract_references(ast, cell_ref)
        
        for ref in refs:
            dependencies.add(ref)
            self._graph.add_edge(cell_ref, ref)
            
            # Recursively trace
            sub_deps, _ = self.trace_dependencies(ref, workbook, context, visited)
            dependencies.update(sub_deps)
        
        return dependencies, self._graph
    
    def _extract_references(self, node: FormulaNode, current_cell: CellReference) -> Set[CellReference]:
        """Extract cell references from AST"""
        refs = set()
        
        if node.node_type == 'REFERENCE':
            ref = self._parse_reference(node.value, current_cell)
            if ref:
                refs.add(ref)
        
        for child in node.children:
            refs.update(self._extract_references(child, current_cell))
        
        return refs
    
    def _parse_reference(self, ref_str: str, current_cell: CellReference) -> Optional[CellReference]:
        """Parse cell reference string"""
        import re
        
        # Handle sheet references
        if '!' in ref_str:
            parts = ref_str.split('!')
            sheet = parts[0].strip("'")
            cell_part = parts[1]
        else:
            sheet = current_cell.sheet
            cell_part = ref_str
        
        # Parse row and column
        match = re.match(r'([A-Z]+)([0-9]+)', cell_part, re.IGNORECASE)
        if match:
            col_str = match.group(1)
            row = int(match.group(2))
            col = self._letter_to_col(col_str)
            return CellReference(sheet=sheet, row=row, col=col)
        
        # Handle range references
        if ':' in cell_part:
            start = cell_part.split(':')[0]
            match = re.match(r'([A-Z]+)([0-9]+)', start, re.IGNORECASE)
            if match:
                col_str = match.group(1)
                row = int(match.group(2))
                col = self._letter_to_col(col_str)
                return CellReference(sheet=sheet, row=row, col=col)
        
        return None
    
    def _letter_to_col(self, letter: str) -> int:
        """Convert column letter to number"""
        result = 0
        for char in letter:
            result = result * 26 + (ord(char.upper()) - 64)
        return result
    
    def detect_cycles(self) -> List[List[CellReference]]:
        """Detect circular dependencies in the graph"""
        cycles = []
        try:
            for cycle in nx.simple_cycles(self._graph):
                cycles.append(list(cycle))
        except:
            pass
        return cycles
    
    def get_dependency_path(self, source: CellReference, target: CellReference) -> List[CellReference]:
        """Get the shortest dependency path between two cells"""
        try:
            return nx.shortest_path(self._graph, source, target)
        except:
            return []

