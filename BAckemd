class ExcelFormulaAnalyzer:
    """Main application orchestrating all components"""
    
    def __init__(self):
        self.tokenizer = ExcelFormulaTokenizer()
        self.parser = ExcelFormulaParser(self.tokenizer)
        self.evaluator = EvaluationEngine()
        self.dependency_engine = DependencyEngine()
        self.issue_detector = IssueDetector()
        self.what_if_engine = WhatIfEngine(self.evaluator, self.dependency_engine)
        self.visualization_engine = VisualizationEngine()
        self.report_generator = ReportGenerator()
        
        self._analysis_cache = {}
    
    def analyze_formula(self,
                       workbook_path: str,
                       sheet: str,
                       cell_address: str,
                       options: Dict = None) -> Dict:
        """
        Complete formula analysis
        
        Args:
            workbook_path: Path to Excel file
            sheet: Sheet name
            cell_address: Cell address (e.g., "F2")
            options: Analysis options
        
        Returns:
            Complete analysis report
        """
        options = options or {}
        context = AnalysisContext()
        
        logger.info(f"Analyzing {sheet}!{cell_address} in {workbook_path}")
        
        try:
            # Step 1: Load workbook
            loader = WorkbookLoader(workbook_path, options)
            workbook = loader.load()
            
            # Step 2: Parse cell reference
            cell_ref = self._parse_cell_reference(sheet, cell_address, workbook)
            context.target_cell = cell_ref
            context.workbook_hash = workbook.hash
            
            # Step 3: Get cell data
            cell_data = workbook.get_cell(cell_ref)
            if not cell_data:
                return self._create_error_report(f"Cell {cell_address} not found", context)
            
            if not cell_data.is_formula:
                return self._create_value_report(cell_data, context)
            
            # Step 4: Parse formula
            ast = self.parser.parse(cell_data.formula, context)
            
            # Step 5: Trace dependencies
            dependencies, graph = self.dependency_engine.trace_dependencies(
                cell_ref, workbook, context
            )
            
            # Step 6: Evaluate formula
            result, trace = self.evaluator.evaluate(ast, context, cell_ref, workbook)
            
            # Step 7: Detect issues
            issues = self.issue_detector.analyze(
                cell_data.formula, cell_ref, dependencies, context
            )
            
            # Step 8: Calculate risk score
            risk_score = self.issue_detector.calculate_risk_score(
                cell_data.formula, dependencies
            )
            
            # Step 9: Generate visualizations
            dep_graph_fig = self.visualization_engine.create_dependency_graph(graph, cell_ref)
            formula_tree_fig = self.visualization_engine.create_formula_tree(ast)
            
            # Step 10: Build report
            report = self._build_report(
                cell_ref, cell_data, ast, result, trace,
                dependencies, graph, issues, risk_score,
                context, dep_graph_fig, formula_tree_fig
            )
            
            # Cache result
            cache_key = f"{workbook.hash}:{cell_ref.address}"
            self._analysis_cache[cache_key] = report
            
            return report
            
        except Exception as e:
            logger.error(f"Analysis failed: {e}", exc_info=True)
            return self._create_error_report(str(e), context)
    
    def _parse_cell_reference(self, sheet: str, address: str, workbook: Workbook) -> CellReference:
        """Parse cell reference"""
        import re
        match = re.match(r'([A-Z]+)([0-9]+)', address, re.IGNORECASE)
        if match:
            col_str = match.group(1)
            row = int(match.group(2))
            col = self._letter_to_col(col_str)
            return CellReference(sheet=sheet, row=row, col=col)
        raise ValueError(f"Invalid cell address: {address}")
    
    def _letter_to_col(self, letter: str) -> int:
        """Convert column letter to number"""
        result = 0
        for char in letter:
            result = result * 26 + (ord(char.upper()) - 64)
        return result
    
    def _build_report(self, cell_ref: CellReference, cell_data: CellData,
                     ast: FormulaNode, result: Any, trace: Dict,
                     dependencies: Set[CellReference], graph: nx.DiGraph,
                     issues: Dict, risk_score: Dict, context: AnalysisContext,
                     dep_graph_fig: go.Figure, formula_tree_fig: go.Figure) -> Dict:
        """Build comprehensive analysis report"""
        
        # Build source lineage
        source_lineage = self._build_source_lineage(cell_ref, dependencies, workbook=None)
        
        # Build calculation steps
        calculation_steps = trace.get('steps', [])
        calculation_steps = [
            {'step': i+1, 'operation': step, 'result': step}
            for i, step in enumerate(calculation_steps[:50])  # Limit to 50 steps
        ]
        
        # Build formula tree string
        formula_tree_str = self._build_formula_tree_string(ast)
        
        # Generate recommendations
        recommendations = self._generate_recommendations(issues, risk_score)
        
        return {
            'cell': cell_ref.address,
            'formula': cell_data.formula,
            'result': result,
            'risk_score': risk_score.get('score', 0),
            'risk_level': risk_score.get('risk_level', 'UNKNOWN'),
            'risk_factors': risk_score.get('factors', []),
            'dependencies_count': len(dependencies),
            'dependencies': [d.address for d in dependencies],
            'source_lineage': source_lineage,
            'calculation_steps': calculation_steps,
            'formula_tree': formula_tree_str,
            'formula_tree_figure': formula_tree_fig.to_json(),
            'dependency_graph_figure': dep_graph_fig.to_json(),
            'issues': issues,
            'warnings': [w['message'] for w in context.warnings],
            'errors': [e['message'] for e in context.errors],
            'recommendations': recommendations,
            'analysis_id': context.analysis_id,
            'timestamp': context.timestamp.isoformat(),
            'metadata': {
                'formula_length': len(cell_data.formula) if cell_data.formula else 0,
                'function_count': self._count_functions(cell_data.formula) if cell_data.formula else 0,
                'lookups_count': len([i for i in issues.get('lookup_operations', [])]),
                'aggregations_count': len([i for i in issues.get('aggregation_operations', [])])
            }
        }
    
    def _build_source_lineage(self, cell_ref: CellReference, 
                             dependencies: Set[CellReference], 
                             workbook: Workbook) -> List[str]:
        """Build source lineage string"""
        lineage = []
        lineage.append(f"{cell_ref.address} = {self._get_cell_value(cell_ref, workbook)}")
        lineage.append("")
        lineage.append("SOURCE LINEAGE:")
        lineage.append("-" * 40)
        
        for dep in dependencies:
            value = self._get_cell_value(dep, workbook)
            lineage.append(f"{dep.address} → {value}")
        
        return lineage
    
    def _get_cell_value(self, ref: CellReference, workbook: Workbook) -> Any:
        """Get cell value"""
        if workbook:
            cell_data = workbook.get_cell(ref)
            return cell_data.value if cell_data else None
        return None
    
    def _build_formula_tree_string(self, ast: FormulaNode, indent: int = 0) -> str:
        """Build formula tree as string"""
        lines = []
        prefix = "  " * indent
        lines.append(f"{prefix}├── {ast.node_type}: {ast.value if ast.value else ''}")
        
        for child in ast.children:
            lines.append(self._build_formula_tree_string(child, indent + 1))
        
        return '\n'.join(lines)
    
    def _count_functions(self, formula: str) -> int:
        """Count number of functions in formula"""
        import re
        return len(re.findall(r'\b[A-Z_]+\s*\(', formula.upper()))
    
    def _generate_recommendations(self, issues: Dict, risk_score: Dict) -> List[str]:
        """Generate recommendations based on issues and risk score"""
        recommendations = []
        
        # Hardcoded values
        if 'hardcoded_values' in issues:
            recommendations.append(
                "Consider moving hardcoded values to named ranges or assumption tables"
            )
        
        # Volatile functions
        if 'volatile_functions' in issues:
            recommendations.append(
                "Replace volatile functions (NOW, TODAY, RAND, etc.) with static values where possible"
            )
        
        # Full column references
        if 'full_column_refs' in issues:
            recommendations.append(
                "Replace full column references with specific ranges for better performance"
            )
        
        # Nested IFs
        if 'nested_ifs' in issues:
            recommendations.append(
                "Consider using IFS or SWITCH instead of multiple nested IF statements"
            )
        
        # Error suppression
        if 'error_suppression' in issues:
            recommendations.append(
                "Review IFERROR/IFNA usage to ensure errors aren't being hidden unintentionally"
            )
        
        # High risk score
        if risk_score.get('score', 0) >= 70:
            recommendations.append(
                "This formula has a high risk score. Consider breaking it down into smaller, simpler formulas"
            )
        
        if not recommendations:
            recommendations.append("No major issues detected. Formula appears well-structured.")
        
        return recommendations
    
    def _create_value_report(self, cell_data: CellData, context: AnalysisContext) -> Dict:
        """Create report for non-formula cells"""
        return {
            'cell': cell_data.reference.address,
            'result': cell_data.value,
            'message': 'This cell contains a value, not a formula',
            'value': cell_data.value,
            'type': cell_data.cell_type.value,
            'analysis_id': context.analysis_id,
            'timestamp': context.timestamp.isoformat()
        }
    
    def _create_error_report(self, message: str, context: AnalysisContext) -> Dict:
        """Create error report"""
        return {
            'error': True,
            'message': message,
            'analysis_id': context.analysis_id,
            'timestamp': context.timestamp.isoformat()
        }

