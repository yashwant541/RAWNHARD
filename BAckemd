    def tokenize(self, formula: str, context: AnalysisContext = None) -> List[Dict]:
        """Tokenize formula with full context and error recovery"""
        if formula in self._token_cache:
            return self._token_cache[formula]
        
        tokens = []
        i = 0
        formula = formula.strip()
        
        if not formula:
            return tokens
        
        # Remove leading '='
        if formula.startswith('='):
            formula = formula[1:]
        
        while i < len(formula):
            char = formula[i]
            
            # Skip whitespace
            if char.isspace():
                i += 1
                continue
            
            # Handle strings
            if char in ('"', "'"):
                start = i
                quote_char = char
                i += 1
                value = ''
                while i < len(formula) and formula[i] != quote_char:
                    if formula[i] == '\\' and i + 1 < len(formula):
                        i += 2
                    else:
                        value += formula[i]
                        i += 1
                if i < len(formula):
                    i += 1
                tokens.append({
                    'type': 'STRING',
                    'value': value,
                    'raw': formula[start:i],
                    'position': start
                })
                continue
            
            # Handle numbers
            if char.isdigit() or char == '.':
                start = i
                is_decimal = False
                while i < len(formula) and (formula[i].isdigit() or (formula[i] == '.' and not is_decimal)):
                    if formula[i] == '.':
                        is_decimal = True
                    i += 1
                tokens.append({
                    'type': 'NUMBER',
                    'value': float(formula[start:i]) if is_decimal else int(formula[start:i]),
                    'raw': formula[start:i],
                    'position': start
                })
                continue
            
            # Handle function names and references
            if char.isalpha() or char == '_':
                start = i
                while i < len(formula) and (formula[i].isalnum() or formula[i] in '._'):
                    i += 1
                token_value = formula[start:i]
                
                # Check if it's a function
                if i < len(formula) and formula[i] == '(':
                    tokens.append({
                        'type': 'FUNCTION',
                        'value': token_value.upper(),
                        'raw': token_value,
                        'position': start,
                        'metadata': self._functions.get(token_value.upper(), {})
                    })
                    # Add the '(' separately
                    tokens.append({
                        'type': 'LPAREN',
                        'value': '(',
                        'position': i
                    })
                    i += 1
                else:
                    # Check if it's a reference or named range
                    if self._is_cell_reference(token_value):
                        tokens.append({
                            'type': 'REFERENCE',
                            'value': token_value,
                            'position': start
                        })
                    else:
                        tokens.append({
                            'type': 'NAMED_RANGE',
                            'value': token_value,
                            'position': start
                        })
                continue
            
            # Handle operators
            if char in self._operators:
                # Check for multi-character operators
                operator = char
                if i + 1 < len(formula) and formula[i:i+2] in self._operators:
                    operator = formula[i:i+2]
                    i += 2
                else:
                    i += 1
                
                tokens.append({
                    'type': 'OPERATOR',
                    'value': operator,
                    'operator_type': self._operators.get(operator, 'UNKNOWN'),
                    'position': start
                })
                continue
            
            # Handle parentheses
            if char in '(){}[]':
                token_type = 'LPAREN' if char == '(' else 'RPAREN'
                tokens.append({
                    'type': token_type,
                    'value': char,
                    'position': i
                })
                i += 1
                continue
            
            # Handle separators
            if char in ',;':
                tokens.append({
                    'type': 'SEPARATOR',
                    'value': char,
                    'position': i
                })
                i += 1
                continue
            
            # Handle ranges
            if char == ':':
                tokens.append({
                    'type': 'RANGE',
                    'value': ':',
                    'position': i
                })
                i += 1
                continue
            
            # Handle errors
            if context:
                context.add_warning(f"Unexpected character '{char}' at position {i}")
            i += 1
        
        self._token_cache[formula] = tokens
        return tokens
    
    def _is_cell_reference(self, token: str) -> bool:
        """Check if token is a valid cell reference"""
        return bool(self.REFERENCE_PATTERN.match(token))

class ExcelFormulaParser:
    """Advanced formula parser with AST generation"""
    
    def __init__(self, tokenizer: ExcelFormulaTokenizer = None):
        self.tokenizer = tokenizer or ExcelFormulaTokenizer()
        self._parse_cache = {}
        self._function_handlers = self._build_function_handlers()
    
    def _build_function_handlers(self) -> Dict:
        """Build function handlers for AST construction"""
        return {
            # Lookup Functions
            'VLOOKUP': self._handle_lookup,
            'XLOOKUP': self._handle_lookup,
            'INDEX': self._handle_index,
            'MATCH': self._handle_match,
            
            # Conditional Functions
            'IF': self._handle_if,
            'IFS': self._handle_ifs,
            'IFERROR': self._handle_iferror,
            'AND': self._handle_logical,
            'OR': self._handle_logical,
            'NOT': self._handle_not,
            
            # Aggregation Functions
            'SUM': self._handle_aggregation,
            'SUMIF': self._handle_aggregation,
            'SUMIFS': self._handle_aggregation,
            'COUNT': self._handle_aggregation,
            'COUNTA': self._handle_aggregation,
            'COUNTIF': self._handle_aggregation,
            'COUNTIFS': self._handle_aggregation,
            'AVERAGE': self._handle_aggregation,
            'AVERAGEIF': self._handle_aggregation,
            'AVERAGEIFS': self._handle_aggregation,
        }
    
    def parse(self, formula: str, context: AnalysisContext = None) -> FormulaNode:
        """Parse formula into AST with caching"""
        cache_key = hashlib.md5(formula.encode()).hexdigest()
        if cache_key in self._parse_cache:
            return self._parse_cache[cache_key]
        
        try:
            tokens = self.tokenizer.tokenize(formula, context)
            ast = self._build_ast(tokens, context)
            self._parse_cache[cache_key] = ast
            return ast
        except Exception as e:
            if context:
                context.add_error(f"Parse error: {str(e)}", {'formula': formula})
            return self._create_error_node(formula, e)
    
    def _build_ast(self, tokens: List[Dict], context: AnalysisContext = None) -> FormulaNode:
        """Build AST from tokens using recursive descent"""
        if not tokens:
            return FormulaNode(node_type='EMPTY')
        
        pos = 0
        return self._parse_expression(tokens, pos, context)[0]
    
    def _parse_expression(self, tokens: List[Dict], pos: int, context: AnalysisContext = None) -> Tuple[FormulaNode, int]:
        """Parse expression with operator precedence"""
        # Parse primary expression
        left, pos = self._parse_primary(tokens, pos, context)
        
        # Handle binary operators
        while pos < len(tokens) and tokens[pos]['type'] == 'OPERATOR':
            operator = tokens[pos]
            pos += 1
            right, pos = self._parse_primary(tokens, pos, context)
            
            # Create operator node
            node = FormulaNode(
                node_type='OPERATOR',
                value=operator['value'],
                metadata={'operator_type': operator.get('operator_type', 'UNKNOWN')}
            )
            node.add_child(left)
            node.add_child(right)
            left = node
        
        return left, pos
    
    def _parse_primary(self, tokens: List[Dict], pos: int, context: AnalysisContext = None) -> Tuple[FormulaNode, int]:
        """Parse primary expression"""
        if pos >= len(tokens):
            return FormulaNode(node_type='EMPTY'), pos
        
        token = tokens[pos]
        
        if token['type'] == 'NUMBER':
            return FormulaNode(node_type='NUMBER', value=token['value']), pos + 1
        
        elif token['type'] == 'STRING':
            return FormulaNode(node_type='STRING', value=token['value']), pos + 1
        
        elif token['type'] == 'REFERENCE':
            return FormulaNode(node_type='REFERENCE', value=token['value']), pos + 1
        
        elif token['type'] == 'NAMED_RANGE':
            return FormulaNode(node_type='NAMED_RANGE', value=token['value']), pos + 1
        
        elif token['type'] == 'FUNCTION':
            function_name = token['value']
            pos += 1  # Skip function name
            
            # Expect '('
            if pos < len(tokens) and tokens[pos]['type'] == 'LPAREN':
                pos += 1  # Skip '('
                
                # Parse arguments
                args = []
                while pos < len(tokens) and tokens[pos]['type'] != 'RPAREN':
                    arg, pos = self._parse_expression(tokens, pos, context)
                    args.append(arg)
                    
                    # Handle separator
                    if pos < len(tokens) and tokens[pos]['type'] == 'SEPARATOR':
                        pos += 1
                
                # Skip ')'
                if pos < len(tokens) and tokens[pos]['type'] == 'RPAREN':
                    pos += 1
                
                # Create function node
                node = FormulaNode(
                    node_type='FUNCTION',
                    value=function_name,
                    metadata={'args_count': len(args)}
                )
                for arg in args:
                    node.add_child(arg)
                
                # Apply function-specific handler
                if function_name in self._function_handlers:
                    return self._function_handlers[function_name](node, context), pos
                
                return node, pos
            
            # Malformed function
            if context:
                context.add_error(f"Malformed function: {function_name}")
            return FormulaNode(node_type='ERROR', value=f"MALFORMED_{function_name}"), pos
        
        elif token['type'] == 'LPAREN':
            # Parenthesized expression
            pos += 1
            expr, pos = self._parse_expression(tokens, pos, context)
            if pos < len(tokens) and tokens[pos]['type'] == 'RPAREN':
                pos += 1
            return expr, pos
        
        else:
            # Unknown token
            if context:
                context.add_warning(f"Unknown token type: {token['type']}")
            return FormulaNode(node_type='UNKNOWN', value=str(token)), pos + 1
    
    def _handle_lookup(self, node: FormulaNode, context: AnalysisContext) -> FormulaNode:
        """Handle lookup functions (VLOOKUP, XLOOKUP)"""
        node.metadata['lookup_type'] = node.value
        node.metadata['requires_evaluation'] = True
        return node
    
    def _handle_index(self, node: FormulaNode, context: AnalysisContext) -> FormulaNode:
        """Handle INDEX function"""
        node.metadata['lookup_type'] = 'INDEX'
