    def __init__(self):
        self._issue_patterns = self._build_issue_patterns()
        self._heuristics = self._build_heuristics()
    
    def _build_issue_patterns(self) -> Dict:
        """Build patterns for detecting issues"""
        return {
            'hardcoded_values': {
                'pattern': r'(?<![A-Za-z0-9_.])\d+(?:\.\d+)?(?![A-Za-z])',
                'severity': 'MEDIUM',
                'description': 'Hardcoded values detected'
            },
            'full_column_refs': {
                'pattern': r'[A-Z]+:[A-Z]+',
                'severity': 'MEDIUM',
                'description': 'Full column reference detected'
            },
            'volatile_functions': {
                'pattern': r'\b(NOW|TODAY|RAND|RANDBETWEEN|OFFSET|INDIRECT)\b',
                'severity': 'HIGH',
                'description': 'Volatile function detected'
            },
            'error_suppression': {
                'pattern': r'\b(IFERROR|IFNA)\b',
                'severity': 'LOW',
                'description': 'Error suppression detected'
            },
            'nested_ifs': {
                'pattern': r'IF\s*\(.*IF\s*\(',
                'severity': 'MEDIUM',
                'description': 'Nested IF statements detected'
            }
        }
    
    def _build_heuristics(self) -> List[Dict]:
        """Build heuristics for complex issue detection"""
        return [
            {
                'name': 'circular_reference',
                'check': self._check_circular_reference,
                'severity': 'CRITICAL',
                'description': 'Circular reference detected'
            },
            {
                'name': 'duplicate_lookup_keys',
                'check': self._check_duplicate_lookup_keys,
                'severity': 'HIGH',
                'description': 'Duplicate lookup keys detected'
            },
            {
                'name': 'inconsistent_formula_pattern',
                'check': self._check_inconsistent_pattern,
                'severity': 'MEDIUM',
                'description': 'Inconsistent formula pattern detected'
            },
            {
                'name': 'external_dependencies',
                'check': self._check_external_dependencies,
                'severity': 'HIGH',
                'description': 'External workbook dependencies detected'
            },
            {
                'name': 'missing_error_handling',
                'check': self._check_missing_error_handling,
                'severity': 'MEDIUM',
                'description': 'Missing error handling detected'
            }
        ]
    
    def analyze(self, 
                formula: str,
                cell_ref: CellReference,
                dependencies: Set[CellReference],
                context: AnalysisContext) -> Dict[str, List[Dict]]:
        """Comprehensive formula analysis"""
        issues = defaultdict(list)
        
        # Check for pattern-based issues
        for issue_name, pattern_data in self._issue_patterns.items():
            matches = re.finditer(pattern_data['pattern'], formula, re.IGNORECASE)
            for match in matches:
                issues[issue_name].append({
                    'value': match.group(),
                    'position': match.start(),
                    'severity': pattern_data['severity'],
                    'description': pattern_data['description']
                })
        
        # Check for heuristic-based issues
        for heuristic in self._heuristics:
            result = heuristic['check'](formula, cell_ref, dependencies, context)
            if result:
                issues[heuristic['name']] = [{
                    'severity': heuristic['severity'],
                    'description': heuristic['description'],
                    'details': result
                }]
        
        return dict(issues)
    
    def _check_circular_reference(self, formula: str, cell_ref: CellReference, 
                                 dependencies: Set[CellReference], context: AnalysisContext) -> Optional[Dict]:
