    def _check_inconsistent_pattern(self, formula: str, cell_ref: CellReference,
                                   dependencies: Set[CellReference], context: AnalysisContext) -> Optional[Dict]:
        """Check for inconsistent formula patterns"""
        # This would require comparing with other cells
        return None
    
    def _check_external_dependencies(self, formula: str, cell_ref: CellReference,
                                    dependencies: Set[CellReference], context: AnalysisContext) -> Optional[Dict]:
        """Check for external workbook dependencies"""
        import re
        external_pattern = r"\[([^\]]+)\]"
        matches = re.findall(external_pattern, formula)
        if matches:
            return {'workbooks': matches}
        return None
    
    def _check_missing_error_handling(self, formula: str, cell_ref: CellReference,
                                     dependencies: Set[CellReference], context: AnalysisContext) -> Optional[Dict]:
        """Check for missing error handling"""
        # Check if formula uses error-prone functions without error handling
        error_prone = ['VLOOKUP', 'XLOOKUP', 'INDEX', 'MATCH', '/', 'DIV']
        has_error_handling = 'IFERROR' in formula.upper() or 'IFNA' in formula.upper()
        
        for func in error_prone:
            if func in formula.upper() and not has_error_handling:
                return {
                    'function': func,
                    'recommendation': f'Consider wrapping {func} in IFERROR or IFNA'
                }
        return None
    
    def calculate_risk_score(self, formula: str, dependencies: Set[CellReference]) -> Dict:
        """Calculate comprehensive risk score"""
        score = 0
        max_score = 100
        
        # Length penalty
        if len(formula) > 300:
            score += 20
        elif len(formula) > 150:
            score += 10
        
        # Dependency count penalty
        if len(dependencies) > 50:
            score += 25
        elif len(dependencies) > 20:
            score += 15
        elif len(dependencies) > 10:
            score += 5
        
        # Function complexity
        functions = re.findall(r'\b[A-Z_]+\s*\(', formula.upper())
        if len(functions) > 10:
            score += 20
        elif len(functions) > 5:
            score += 10
        
        # Volatile functions
        volatile = re.findall(r'\b(NOW|TODAY|RAND|RANDBETWEEN|OFFSET|INDIRECT)\b', formula.upper())
        if volatile:
            score += len(volatile) * 5
        
        # Hardcoded values
        hardcoded = re.findall(r'(?<![A-Za-z0-9_.])\d+(?:\.\d+)?(?![A-Za-z])', formula)
        if hardcoded:
            score += len(hardcoded) * 3
        
        # Cross-sheet references
        cross_sheet = re.findall(r"[A-Za-z_]+![A-Z]+[0-9]+", formula)
        if cross_sheet:
            score += len(cross_sheet) * 3
        
        # Determine risk level
        if score >= 70:
            risk_level = 'CRITICAL'
        elif score >= 50:
            risk_level = 'HIGH'
        elif score >= 30:
            risk_level = 'MEDIUM'
        else:
            risk_level = 'LOW'
        
        return {
            'score': min(score, max_score),
            'risk_level': risk_level,
            'factors': self._get_risk_factors(formula)
        }
    
    def _get_risk_factors(self, formula: str) -> List[str]:
        """Get list of risk factors"""
        factors = []
        
        if len(formula) > 200:
            factors.append('Very long formula')
        
        if re.search(r'\b(NOW|TODAY|RAND|RANDBETWEEN|OFFSET|INDIRECT)\b', formula.upper()):
            factors.append('Contains volatile functions')
        
        if re.search(r'(?<![A-Za-z0-9_.])\d+(?:\.\d+)?(?![A-Za-z])', formula):
            factors.append('Contains hardcoded values')
        
        if re.findall(r'IF\s*\(.*IF\s*\(', formula, re.IGNORECASE):
            factors.append('Multiple nested IF statements')
        
        if re.findall(r"[A-Za-z_]+![A-Z]+[0-9]+", formula):
            factors.append('Multiple cross-sheet references')
        
        if re.search(r'[A-Z]+:[A-Z]+', formula):
            factors.append('Full column references')
        
        return factors

