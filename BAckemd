@dataclass
class CellReference:
    """Immutable cell reference with full context"""
    sheet: str
    row: int
    col: int
    workbook: Optional[str] = None
    _hash: Optional[str] = None
    
    def __post_init__(self):
        self._hash = hashlib.md5(
            f"{self.workbook}:{self.sheet}:{self.row}:{self.col}".encode()
        ).hexdigest()[:12]
    
    @property
    def address(self) -> str:
        """Full address including sheet name"""
        return f"{self.sheet}!{self._col_to_letter(self.col)}{self.row}"
    
    @property
    def a1_address(self) -> str:
        """A1-style address"""
        return f"{self._col_to_letter(self.col)}{self.row}"
    
    @property
    def r1c1_address(self) -> str:
        """R1C1-style address"""
        return f"R{self.row}C{self.col}"
    
    @staticmethod
    def _col_to_letter(col: int) -> str:
        """Convert column number to letter"""
        result = []
        while col > 0:
            col, remainder = divmod(col - 1, 26)
            result.append(chr(65 + remainder))
        return ''.join(reversed(result))
    
    @staticmethod
    def _letter_to_col(letter: str) -> int:
        """Convert column letter to number"""
        result = 0
        for char in letter:
            result = result * 26 + (ord(char.upper()) - 64)
        return result
    
    def __hash__(self):
        return hash(self._hash)
    
    def __eq__(self, other):
        if not isinstance(other, CellReference):
            return False
        return (self.sheet == other.sheet and 
                self.row == other.row and 
                self.col == other.col and
                self.workbook == other.workbook)

@dataclass
class CellData:
    """Complete cell data"""
    reference: CellReference
    value: Any = None
    formula: Optional[str] = None
    cell_type: CellType = CellType.EMPTY
    data_type: str = "unknown"
    formatting: Dict[str, Any] = field(default_factory=dict)
    is_hidden: bool = False
    is_locked: bool = False
    comment: Optional[str] = None
    cached_value: Any = None
    
    @property
    def is_formula(self) -> bool:
        return self.cell_type == CellType.FORMULA
    
    @property
    def is_empty(self) -> bool:
        return self.cell_type == CellType.EMPTY
    
    def to_dict(self) -> Dict:
        return {
            'reference': self.reference.address,
            'value': self.value,
            'formula': self.formula,
            'type': self.cell_type.value,
            'data_type': self.data_type,
            'is_hidden': self.is_hidden,
            'is_locked': self.is_locked,
            'comment': self.comment
        }

@dataclass
class FormulaNode:
    """Abstract Syntax Tree node"""
    node_type: str
    value: Any = None
    children: List['FormulaNode'] = field(default_factory=list)
    metadata: Dict[str, Any] = field(default_factory=dict)
    _id: str = field(default_factory=lambda: hashlib.md5(str(datetime.now()).encode()).hexdigest()[:8])
    parent: Optional['FormulaNode'] = None
    
    def add_child(self, child: 'FormulaNode'):
        child.parent = self
        self.children.append(child)
    
    def to_dict(self) -> Dict:
        return {
            'id': self._id,
            'type': self.node_type,
            'value': self.value,
            'metadata': self.metadata,
            'children': [c.to_dict() for c in self.children]
        }
    
    def to_json(self) -> str:
        return json.dumps(self.to_dict(), indent=2)
    
    def __repr__(self) -> str:
        return f"FormulaNode({self.node_type}, {self.value}, {len(self.children)} children)"

@dataclass
class AnalysisContext:
    """Context for a single analysis session"""
    analysis_id: str = field(default_factory=lambda: hashlib.md5(str(datetime.now()).encode()).hexdigest()[:16])
    timestamp: datetime = field(default_factory=datetime.now)
    target_cell: Optional[CellReference] = None
    workbook_hash: Optional[str] = None
    settings: Dict[str, Any] = field(default_factory=dict)
    cache: Dict[str, Any] = field(default_factory=dict)
    warnings: List[Dict[str, Any]] = field(default_factory=list)
    errors: List[Dict[str, Any]] = field(default_factory=list)
    execution_path: List[str] = field(default_factory=list)
    visited_cells: Set[CellReference] = field(default_factory=set)
    
    def add_warning(self, message: str, details: Dict = None):
        self.warnings.append({
            'timestamp': datetime.now().isoformat(),
            'message': message,
            'details': details or {}
        })
        logger.warning(f"Warning: {message}")
    
    def add_error(self, message: str, details: Dict = None):
        self.errors.append({
            'timestamp': datetime.now().isoformat(),
            'message': message,
            'details': details or {}
        })
        logger.error(f"Error: {message}")
    
    def to_dict(self) -> Dict:
        return {
            'analysis_id': self.analysis_id,
            'timestamp': self.timestamp.isoformat(),
            'target_cell': self.target_cell.address if self.target_cell else None,
            'workbook_hash': self.workbook_hash,
            'warnings': self.warnings,
            'errors': self.errors,
            'execution_path': self.execution_path
        }

