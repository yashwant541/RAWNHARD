# -----------------------------------------------------------------------------

class WhatIfEngine:
    """Advanced what-if analysis with impact simulation"""
    
    def __init__(self, evaluation_engine: EvaluationEngine, dependency_engine: DependencyEngine):
        self.evaluation_engine = evaluation_engine
        self.dependency_engine = dependency_engine
        self._simulation_cache = {}
    
    def simulate_change(self,
                       target_cell: CellReference,
                       changed_cell: CellReference,
                       new_value: Any,
                       workbook: Workbook,
                       context: AnalysisContext) -> Dict:
        """Simulate changing a cell value and show impact"""
        
        # Get original trace
        original_deps, original_graph = self.dependency_engine.trace_dependencies(
            target_cell, workbook, context
        )
        
        # Save original value
        original_data = workbook.get_cell(changed_cell)
        original_value = original_data.value if original_data else None
        
        # Apply change
        if original_data:
            original_data.value = new_value
            original_data.cached_value = new_value
        
        # Re-evaluate with change
        parser = ExcelFormulaParser()
        cell_data = workbook.get_cell(target_cell)
        if cell_data and cell_data.is_formula:
            ast = parser.parse(cell_data.formula, context)
            new_result, trace = self.evaluation_engine.evaluate(
                ast, context, target_cell, workbook
            )
        else:
            new_result = workbook.get_cell(target_cell).value if workbook.get_cell(target_cell) else None
        
        # Restore original value
        if original_data:
            original_data.value = original_value
            original_data.cached_value = original_value
        
        # Generate impact analysis
        impact = self._analyze_impact(
            target_cell, changed_cell, original_value, new_value,
            original_deps, workbook, context
        )
        
        return {
            'cell': target_cell.address,
            'original_result': original_value,
            'new_result': new_result,
            'change': {
                'cell': changed_cell.address,
                'old_value': original_value,
                'new_value': new_value
            },
            'difference': self._safe_subtract(new_result, original_value),
            'impact_path': impact['path'],
            'affected_cells': impact['affected_cells'],
            'summary': impact['summary']
        }
    
    def _analyze_impact(self, target: CellReference, changed: CellReference,
                        old_value: Any, new_value: Any,
                        dependencies: Set[CellReference], workbook: Workbook,
                        context: AnalysisContext) -> Dict:
        """Analyze the full impact of a change"""
        
        # Find affected cells
        affected = []
        path = []
        
        # Trace impact path
        current = changed
        while current != target:
            path.append(current.address)
            # Find next cell in dependency chain
            next_cell = self._find_next_in_chain(current, target, workbook)
            if not next_cell:
                break
            current = next_cell
        
        if current == target:
            path.append(target.address)
        
        # Find all cells that depend on the changed cell
        for cell, cell_data in workbook.cells.items():
            if cell_data.is_formula:
                deps, _ = self.dependency_engine.trace_dependencies(cell, workbook, context)
                if changed in deps:
                    affected.append(cell.address)
        
        return {
            'path': path,
            'affected_cells': affected[:100],  # Limit to 100
            'affected_count': len(affected),
            'summary': self._generate_impact_summary(
                changed, old_value, new_value, len(affected), path
            )
        }
    
    def _find_next_in_chain(self, current: CellReference, target: CellReference,
                           workbook: Workbook) -> Optional[CellReference]:
        """Find the next cell in the dependency chain"""
        # Look for formulas that reference current
        for cell, cell_data in workbook.cells.items():
            if cell_data.is_formula:
                deps, _ = self.dependency_engine.trace_dependencies(cell, workbook, AnalysisContext())
                if current in deps:
                    return cell
        return None
    
    def _generate_impact_summary(self, changed: CellReference, old_value: Any,
                                 new_value: Any, affected_count: int, path: List[str]) -> str:
        """Generate human-readable impact summary"""
        return (f"Changing {changed.address} from {old_value} to {new_value} "
                f"affects {affected_count} cells. Impact path: {' → '.join(path[:5])}"
                f"{'...' if len(path) > 5 else ''}")
    
    def _safe_subtract(self, a: Any, b: Any) -> Any:
        """Safely subtract values, handling None"""
        if a is None and b is None:
            return 0
        if a is None:
            return -b if isinstance(b, (int, float)) else None
        if b is None:
            return a if isinstance(a, (int, float)) else None
        if isinstance(a, (int, float)) and isinstance(b, (int, float)):
            return a - b
        return None

