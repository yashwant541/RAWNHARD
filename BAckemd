        result = round(args[0], int(args[1]))
        trace['steps'].append(f"ROUND({args[0]}, {args[1]}) = {result}")
        return result, trace
    
    def _evaluate_roundup(self, args: List, node: FormulaNode, context: AnalysisContext,
                         cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate ROUNDUP"""
        trace = {'steps': [], 'details': {'function': 'ROUNDUP'}}
        import math
        if len(args) < 2:
            return None, {'error': 'Missing arguments', 'executed': False}
        decimals = int(args[1])
        factor = 10 ** decimals
        result = math.ceil(args[0] * factor) / factor
        trace['steps'].append(f"ROUNDUP({args[0]}, {args[1]}) = {result}")
        return result, trace
    
    def _evaluate_rounddown(self, args: List, node: FormulaNode, context: AnalysisContext,
                           cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate ROUNDDOWN"""
        trace = {'steps': [], 'details': {'function': 'ROUNDDOWN'}}
        import math
        if len(args) < 2:
            return None, {'error': 'Missing arguments', 'executed': False}
        decimals = int(args[1])
        factor = 10 ** decimals
        result = math.floor(args[0] * factor) / factor
        trace['steps'].append(f"ROUNDDOWN({args[0]}, {args[1]}) = {result}")
        return result, trace
    
    def _evaluate_abs(self, args: List, node: FormulaNode, context: AnalysisContext,
                     cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate ABS"""
        trace = {'steps': [], 'details': {'function': 'ABS'}}
        if not args:
            return None, {'error': 'Missing argument', 'executed': False}
        result = abs(args[0])
        trace['steps'].append(f"ABS({args[0]}) = {result}")
        return result, trace
    
    def _evaluate_mod(self, args: List, node: FormulaNode, context: AnalysisContext,
                     cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate MOD"""
        trace = {'steps': [], 'details': {'function': 'MOD'}}
        if len(args) < 2:
            return None, {'error': 'Missing arguments', 'executed': False}
        result = args[0] % args[1]
        trace['steps'].append(f"MOD({args[0]}, {args[1]}) = {result}")
        return result, trace
    
    def _evaluate_power(self, args: List, node: FormulaNode, context: AnalysisContext,
                       cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate POWER"""
        trace = {'steps': [], 'details': {'function': 'POWER'}}
        if len(args) < 2:
            return None, {'error': 'Missing arguments', 'executed': False}
        result = args[0] ** args[1]
        trace['steps'].append(f"POWER({args[0]}, {args[1]}) = {result}")
        return result, trace
    
    def _evaluate_product(self, args: List, node: FormulaNode, context: AnalysisContext,
                         cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate PRODUCT"""
        trace = {'steps': [], 'details': {'function': 'PRODUCT'}}
        result = 1
        for a in args:
            if isinstance(a, (int, float)):
                result *= a
        trace['steps'].append(f"PRODUCT: {result}")
        return result, trace
    
    def _evaluate_left(self, args: List, node: FormulaNode, context: AnalysisContext,
                      cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate LEFT"""
        trace = {'steps': [], 'details': {'function': 'LEFT'}}
        if len(args) < 2:
            return None, {'error': 'Missing arguments', 'executed': False}
        text = str(args[0])
        length = int(args[1])
        result = text[:length]
        trace['steps'].append(f"LEFT({text}, {length}) = {result}")
        return result, trace
    
    def _evaluate_right(self, args: List, node: FormulaNode, context: AnalysisContext,
                       cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate RIGHT"""
        trace = {'steps': [], 'details': {'function': 'RIGHT'}}
        if len(args) < 2:
            return None, {'error': 'Missing arguments', 'executed': False}
        text = str(args[0])
        length = int(args[1])
        result = text[-length:] if length <= len(text) else text
        trace['steps'].append(f"RIGHT({text}, {length}) = {result}")
        return result, trace
    
    def _evaluate_mid(self, args: List, node: FormulaNode, context: AnalysisContext,
                     cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate MID"""
        trace = {'steps': [], 'details': {'function': 'MID'}}
        if len(args) < 3:
            return None, {'error': 'Missing arguments', 'executed': False}
        text = str(args[0])
        start = int(args[1]) - 1  # Excel uses 1-based indexing
        length = int(args[2])
        result = text[start:start+length]
        trace['steps'].append(f"MID({text}, {args[1]}, {args[2]}) = {result}")
        return result, trace
    
    def _evaluate_len(self, args: List, node: FormulaNode, context: AnalysisContext,
                     cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate LEN"""
        trace = {'steps': [], 'details': {'function': 'LEN'}}
        if not args:
            return None, {'error': 'Missing argument', 'executed': False}
        result = len(str(args[0]))
        trace['steps'].append(f"LEN({args[0]}) = {result}")
        return result, trace
    
    def _evaluate_trim(self, args: List, node: FormulaNode, context: AnalysisContext,
                      cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate TRIM"""
        trace = {'steps': [], 'details': {'function': 'TRIM'}}
        if not args:
            return None, {'error': 'Missing argument', 'executed': False}
        result = str(args[0]).strip()
        trace['steps'].append(f"TRIM('{args[0]}') = '{result}'")
        return result, trace
    
    def _evaluate_concat(self, args: List, node: FormulaNode, context: AnalysisContext,
                        cell_ref: CellReference, workbook: Workbook) -> Tuple[Any, Dict]:
        """Evaluate CONCAT"""
        trace = {'steps': [], 'details': {'function': 'CONCAT'}}
        result = ''.join(str(a) for a in args if a is not None)
        trace['steps'].append(f"CONCAT: {result}")
        return result, trace
    
    def _parse_reference(self, ref_str: str, cell_ref: CellReference) -> CellReference:
        """Parse cell reference string"""
        # Handle sheet references
        if '!' in ref_str:
            parts = ref_str.split('!')
            sheet = parts[0].strip("'")
            cell_part = parts[1]
        else:
            sheet = cell_ref.sheet
            cell_part = ref_str
        
        # Parse row and column
        import re
        match = re.match(r'([A-Z]+)([0-9]+)', cell_part, re.IGNORECASE)
        if match:
            col_str = match.group(1)
            row = int(match.group(2))
            col = self._letter_to_col(col_str)
            return CellReference(sheet=sheet, row=row, col=col)
        
        # Handle range references
        if ':' in cell_part:
            # Return first cell of range
            start = cell_part.split(':')[0]
            match = re.match(r'([A-Z]+)([0-9]+)', start, re.IGNORECASE)
            if match:
                col_str = match.group(1)
                row = int(match.group(2))
                col = self._letter_to_col(col_str)
                return CellReference(sheet=sheet, row=row, col=col)
        
        return None
    
    def _letter_to_col(self, letter: str) -> int:
        """Convert column letter to number"""
        result = 0
        for char in letter:
            result = result * 26 + (ord(char.upper()) - 64)
        return result
    
    def _get_cache_key(self, node: FormulaNode, context: AnalysisContext, cell_ref: CellReference) -> str:
        """Generate cache key for evaluation"""
        return hashlib.md5(
            f"{node.to_json()}:{cell_ref.address}:{context.analysis_id}".encode()
        ).hexdigest()

