<h1>
Excel Formula Backtracking
</h1>

<p>
Interactive Formula Calculation & Lineage Analysis
</p>

</div>


<div class="container">


<div class="formula-box">

<h3>
Original Formula
</h3>


<div class="formula">
{escape(FORMULA)}
</div>


<div class="legend">


<div class="legend-item">

<div
class="dot"
