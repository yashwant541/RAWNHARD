            return self._generate_html_report(analysis_data)
        elif format_type == 'json':
            return self._generate_json_report(analysis_data)
        elif format_type == 'txt':
            return self._generate_text_report(analysis_data)
        else:
            raise ValueError(f"Unsupported format: {format_type}")
    
    def _generate_html_report(self, data: Dict) -> str:
        """Generate HTML report"""
        template = jinja2.Template(self._templates['html'])
        return template.render(data=data)
    
    def _generate_json_report(self, data: Dict) -> str:
        """Generate JSON report"""
        return json.dumps(data, indent=2, default=str)
    
    def _generate_text_report(self, data: Dict) -> str:
