class ExcelFormulaTokenizer:
    """Advanced tokenizer with error recovery"""
    
    FUNCTION_PATTERN = re.compile(r'^[A-Z_][A-Z0-9_]*$', re.IGNORECASE)
    REFERENCE_PATTERN = re.compile(r'^([A-Z]+)([0-9]+)$', re.IGNORECASE)
    SHEET_REFERENCE_PATTERN = re.compile(r"^'?([^']+)'?!([A-Z]+)([0-9]+)$", re.IGNORECASE)
    RANGE_PATTERN = re.compile(r'^([A-Z]+):([A-Z]+)$', re.IGNORECASE)
    NAMED_RANGE_PATTERN = re.compile(r'^[A-Z_][A-Z0-9_.]*$', re.IGNORECASE)
    
    def __init__(self):
        self._operators = {
            '+': 'ADD', '-': 'SUBTRACT', '*': 'MULTIPLY', '/': 'DIVIDE',
            '^': 'POWER', '%': 'PERCENT',
